# Maintainer: Kestrel <https://github.com/kestrel-distro>
pkgname=ghostty-kestrel
pkgver=1.3.2
pkgrel=1
pkgdesc='Ghostty with the Kestrel per-task scheduling hint'
arch=(x86_64)
url='https://github.com/kestrel-distro/ghostty'
license=(MIT)
depends=(bzip2 fontconfig freetype2 glib2 gtk4 gtk4-layer-shell libx11
         harfbuzz libadwaita libpng oniguruma pixman wayland zlib)
makedepends=(blueprint-compiler pandoc-cli zig git)
provides=(ghostty)
conflicts=(ghostty)
source=()
sha256sums=()

build() {
    cd "${startdir}/../.."
    # Zig 0.17 fetches packages into its own cache; the pre-0.17
    # fetch-zig-cache.sh + --system pair leaves tarballs where the build
    # expects extracted package directories.
    DESTDIR="$srcdir/build" zig build --summary all --prefix /usr \
        -Doptimize=ReleaseFast -Dgtk-x11=true -Dcpu=baseline -Dpie=true \
        -Demit-docs -Dversion-string="${pkgver}-kestrel${pkgrel}" --build-id=sha1
}

package() {
    cd "${startdir}/../.."
    cp -a "$srcdir/build/." "$pkgdir/"

    # ncurses owns /usr/share/terminfo/g/ghostty. Keep the xterm-ghostty
    # entry, which no other package provides, and drop the duplicate.
    rm -f "$pkgdir/usr/share/terminfo/g/ghostty"
    rmdir "$pkgdir/usr/share/terminfo/g" 2>/dev/null || true

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
